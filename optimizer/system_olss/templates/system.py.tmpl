class __CLASS_NAME__(OLSS):
    """__SYSTEM_NAME__."""

    def __init__(
        self,
        primary: Mapping[str, Any] | None = None,
        secondary: Mapping[str, Any] | None = None,
    ) -> None:
        primary_defaults = {"variable_size": 1, "residual_size": 1}
        secondary_defaults: dict[str, Any] = {}
        self.primary = {**primary_defaults, **dict(primary or {})}
        self.secondary = {**secondary_defaults, **dict(secondary or {})}
        self._shooting_spec = ShootingSpec(
            (
                ShootingBlock(
                    "variables",
                    shape=(int(self.primary["variable_size"]),),
                    meaning="TODO: name and split the physical shooting variables",
                ),
            )
        )

    def system_spec(self) -> dict[str, Any]:
        return basic_shooting_system_spec(
            "__SYSTEM_ID__",
            name="__SYSTEM_NAME__",
            system_type="__SYSTEM_TYPE__",
            description="TODO: describe the shooting formulation and boundary conditions.",
            shooting_spec=self.shooting_spec(),
            residual_size=int(self.primary["residual_size"]),
            parameters={
                "primary": dict(self.primary),
                "secondary": dict(self.secondary),
            },
            jacobian_source="analytical",
            verification_options={"accuracy": "verification"},
        )

    def shooting_spec(self) -> ShootingSpec:
        return self._shooting_spec

    def residuals(
        self,
        variables: ShootingVariables,
        *,
        options: Mapping[str, Any] | None = None,
    ) -> np.ndarray:
        raise NotImplementedError("TODO: implement the complete unscaled residual vector.")

    def jacobian(
        self,
        variables: ShootingVariables,
        *,
        options: Mapping[str, Any] | None = None,
    ) -> np.ndarray:
        raise NotImplementedError("TODO: implement the analytical residual Jacobian.")

    def with_secondary(self, **updates: Any) -> "__CLASS_NAME__":
        secondary = dict(self.secondary)
        secondary.update(updates)
        return type(self)(primary=self.primary, secondary=secondary)


def system(config: Mapping[str, Any] | None = None, **updates: Any) -> __CLASS_NAME__:
    """Construct the project system from dict-first configuration."""

    payload = dict(config or {})
    primary = payload.pop("primary", None)
    secondary = payload.pop("secondary", None)
    if payload:
        raise KeyError(f"Unknown top-level configuration keys: {sorted(payload)}")
    return __CLASS_NAME__(primary=primary, secondary={**dict(secondary or {}), **updates})
